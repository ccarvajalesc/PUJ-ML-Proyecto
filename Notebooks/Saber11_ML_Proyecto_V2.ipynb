    "        'precision_macro': '{:.4f}', 'recall_macro': '{:.4f}', 'roc_auc': '{:.4f}'\n",
    "    })\n",
    "    .background_gradient(subset=['f1_macro'], cmap='YlGn')\n",
    ")\n"
